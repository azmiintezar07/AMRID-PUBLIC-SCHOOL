# ==============================================================================
# AMRID PUBLIC SCHOOL - Environment Configuration Template
# Copy this file to '.env' and fill in your production credentials.
# NOTE: Never commit your real '.env' file containing secrets to Git!
# ==============================================================================

# Server Configuration
PORT=8000
NODE_ENV=production

# Security & Admin Authentication
# Optional: Override the default admin credentials and JWT secret
# ADMIN_USERNAME=Azmi
# ADMIN_PASSWORD_HASH= (Bcrypt hash)
JWT_SECRET=aps_jwt_secret_production_random_key_change_me_2026

# Administrator Contact Numbers (For WhatsApp & SMS notifications)
# Format with country code (e.g., +919876543210 or 919876543210)
DIRECTOR_PHONE=+919876543210
PRINCIPAL_PHONE=+919876543211

# ==============================================================================
# OFFICIAL WHATSAPP BUSINESS NOTIFICATIONS (Meta Cloud API)
# ==============================================================================
# Obtain from developers.facebook.com -> WhatsApp App -> API Setup
WHATSAPP_API_TOKEN=your_meta_system_user_access_token_here
WHATSAPP_PHONE_NUMBER_ID=your_meta_phone_number_id_here

# ==============================================================================
# SMS NOTIFICATIONS
# Configure either Option A (Twilio) or Option B (Fast2SMS / Indian Gateway)
# ==============================================================================

# Option A: Twilio SMS Gateway
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=your_twilio_purchased_phone_number_here

# Option B: Fast2SMS (Indian Gateway)
# FAST2SMS_API_KEY=your_fast2sms_api_key_here

# Option C: Custom SMS REST API Endpoint (e.g., MSG91, Textlocal, etc.)
# SMS_API_ENDPOINT=https://api.sms-provider.com/v1/send
# SMS_API_KEY=your_sms_gateway_api_key_here
