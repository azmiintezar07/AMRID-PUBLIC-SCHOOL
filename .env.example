# ==============================================================================
# AMRID PUBLIC SCHOOL - Production Environment Variables Template
# Copy this file to '.env' and fill in your actual credentials.
# NEVER commit the real '.env' file containing secrets to Git!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVER & ENVIRONMENT CONFIGURATION
# ------------------------------------------------------------------------------
PORT=8000
NODE_ENV=production

# URLs for CORS and cross-origin cookie handling
# In production, set FRONTEND_URL to your deployed domain(s), comma-separated if multiple
FRONTEND_URL=https://amridpublicschool.com
BACKEND_URL=https://amridpublicschool.com

# Frontend API base URL (leave blank if frontend and backend share the same domain)
# Example if separate: https://api.amridpublicschool.com
VITE_API_URL=

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (MongoDB Atlas)
# ------------------------------------------------------------------------------
# Leave empty to use local JSON file store (public/data/content.json, submissions.json)
# Or provide your MongoDB Atlas connection string:
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/amrid_school?retryWrites=true&w=majority

# ------------------------------------------------------------------------------
# 3. ADMIN AUTHENTICATION & SECURITY
# ------------------------------------------------------------------------------
# Administrator credentials for /admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_to_a_strong_password_in_production

# Optional: Bcrypt hash of admin password (takes precedence over ADMIN_PASSWORD if set)
# ADMIN_PASSWORD_HASH=$2b$10$...

# Secret key used for signing JWT authentication session cookies/tokens
# Use a strong, random 32+ character string
JWT_SECRET=your_super_strong_random_jwt_secret_change_me_in_production_2026

# ------------------------------------------------------------------------------
# 4. ADMINISTRATOR CONTACT NUMBERS
# ------------------------------------------------------------------------------
# Recipients for WhatsApp & SMS alerts when new admission enquiries are submitted
DIRECTOR_PHONE=+918434149789
PRINCIPAL_PHONE=+919693264161

# ------------------------------------------------------------------------------
# 5. OFFICIAL WHATSAPP BUSINESS NOTIFICATIONS (Meta Cloud API)
# ------------------------------------------------------------------------------
# Obtain from developers.facebook.com -> WhatsApp App -> API Setup
WHATSAPP_ACCESS_TOKEN=your_meta_system_user_access_token_here
WHATSAPP_PHONE_NUMBER_ID=your_meta_phone_number_id_here

# ------------------------------------------------------------------------------
# 6. TWILIO NOTIFICATIONS (WhatsApp & SMS)
# ------------------------------------------------------------------------------
# Obtain from twilio.com/console
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890

# Optional Twilio sender numbers (fall back to TWILIO_PHONE_NUMBER if not set)
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# TWILIO_SMS_FROM=+1234567890

# ------------------------------------------------------------------------------
# 7. ALTERNATIVE INDIAN SMS GATEWAYS (Optional)
# ------------------------------------------------------------------------------
# Fast2SMS or Custom HTTP SMS Gateway
# SMS_API_KEY=your_fast2sms_or_gateway_api_key_here
# SMS_API_URL=https://api.sms-provider.com/v1/send
# SMS_SENDER_ID=AMRID

# ------------------------------------------------------------------------------
# 8. CLOUD STORAGE FOR FILE UPLOADS (Optional - Cloudinary)
# ------------------------------------------------------------------------------
# If deploying to hosting platforms with ephemeral storage (e.g., Render free tier, Heroku)
# CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
# CLOUDINARY_API_KEY=your_cloudinary_api_key
# CLOUDINARY_API_SECRET=your_cloudinary_api_secret
